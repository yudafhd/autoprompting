{
  "manifest_version": 3,
  "name": "AutoPrompting",
  "version": "1.0.0",
  "description": "Otomatisasi input prompt, kirim, tunggu respons selesai, buka New Chat, dan unduh gambar otomatis di Meta.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutoPrompting Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "notifications"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Buka Dashboard AutoPrompting di Tab Baru"
    },
    "toggle_pause": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Jeda atau lanjutkan antrian AutoPrompting"
    }
  },
  "host_permissions": [
    "*://*.meta.ai/*",
    "*://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.meta.ai/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
